{
  "name": "market-radar-vercel",
  "version": "2.0.0",
  "private": true,
  "description": "Escaner de senales para el S&P 500 en Vercel, sin tokens de pago. Estrategias momentum e insiders con paper trading y ranking.",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1",
    "scan": "node scripts/run-local.js",
    "scan:fast": "node scripts/run-local.js --maxSymbols=120",
    "scan:insider": "node scripts/run-local.js --workspace=insider",
    "scan:insider-total": "node scripts/run-local.js --workspace=insider_total",
    "scan:chatgpt-sp500": "node scripts/run-local.js --workspace=insider_total",
    "scan:insider-sp500-nasdaq": "node scripts/run-local.js --workspace=insider_sp500_nasdaq",
    "track": "node scripts/track.js",
    "track:momentum": "node scripts/track.js --workspace=momentum",
    "track:insider": "node scripts/track.js --workspace=insider",
    "track:insider-total": "node scripts/track.js --workspace=insider_total",
    "track:chatgpt-sp500": "node scripts/track.js --workspace=insider_total",
    "track:insider-sp500-nasdaq": "node scripts/track.js --workspace=insider_sp500_nasdaq",
    "vercel:dev": "vercel dev",
    "deploy": "vercel deploy --prod"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "vite": "^5.4.11"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "UNLICENSED"
}
